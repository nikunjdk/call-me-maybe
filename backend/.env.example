# Template only. API keys go in .env.local (gitignored).
# `cp .env.example .env` does not touch .env.local.
# Do not commit .env or .env.local.

HOST=0.0.0.0
PORT=8000

# A's dial hook — C will POST here on approve (not wired yet)
DIAL_WEBHOOK_URL=

# --- Tier 1: IFM K2 (hosted) ---
TIER1_BASE_URL=https://api.ifm.ai/v1
TIER1_API_KEY=
TIER1_MODEL=IFM/K2-Horizon-375B-A23B
TIER1_LABEL=K2-375B · IFM API
TIER1_TIMEOUT=8
# TIER1_RESPONSE_FORMAT=0
# TIER1_REASONING_EFFORT=low

# --- Tier 1 swap: self-hosted (vLLM / llama.cpp). Three lines. ---
# TIER1_BASE_URL=http://127.0.0.1:30000/v1
# TIER1_API_KEY=EMPTY
# TIER1_LABEL=K2-0.9B · vLLM

# Local fake server for failure tests: python -m app.llm.fake_server
# TIER1_BASE_URL=http://127.0.0.1:8765/v1
# TIER1_API_KEY=fake
# TIER1_MODEL=fake-tier1
# TIER1_LABEL=fake-tier1
# TIER1_TIMEOUT=2

# --- Tier 2: Grok, uncertain band only ---
TIER2_BASE_URL=https://api.x.ai/v1
TIER2_API_KEY=
TIER2_MODEL=grok-4.6
TIER2_LABEL=Grok · xAI
TIER2_TIMEOUT=12

# --- Planner (call plan) ---
PLANNER_BASE_URL=https://api.x.ai/v1
PLANNER_API_KEY=
PLANNER_MODEL=grok-4.6
PLANNER_LABEL=Grok · planner
PLANNER_TIMEOUT=20

# --- Extractor (booking + summary) ---
EXTRACTOR_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
EXTRACTOR_API_KEY=
EXTRACTOR_MODEL=gemini-flash-latest
EXTRACTOR_LABEL=Gemini · extractor
EXTRACTOR_TIMEOUT=30

GATE_UNCERTAIN_THRESHOLD=0.75
TURN_BUDGET_MS=2500

# MongoDB Atlas write-through (optional). Unset = in-memory only.
MONGODB_URI=
MONGODB_DB=callmemaybe

# Member A / Twilio — fill locally, never commit .env
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_API_KEY=
TWILIO_API_SECRET=
TWILIO_TWIML_APP_SID=
TWILIO_CALLER_NUMBER=
TWILIO_SIM_REP_NUMBER=
TWILIO_LIVE_REP_NUMBER=
REP_MODE=scripted
PUBLIC_BASE_URL=
TWILIO_VALIDATE_SIGNATURE=false
